# Same Google OAuth client as Corsair Hackathon
# Authorized redirect URI must be:
# http://localhost:3000/api-auth/google/callback

GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-your-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api-auth/google/callback

JWT_SECRET=change-me-to-a-long-random-secret
JWT_REFRESH_SECRET=change-me-to-another-long-random-secret

# Hackathon demo — mock fallback when OSS services are down
DEMO_MODE=true

# Open-source services live in ./services/ (cloned via npm run setup:oss)
# Start stack: npm run oss:up  →  then npm run oss:init  →  npm run dev

# Real OSS mode:
# DEMO_MODE=false
# KYC_PROVIDER=simple-kyc
# AML_PROVIDER=yente

# KYC: mock | simple-kyc | eudi
KYC_PROVIDER=mock
SIMPLE_KYC_BASE_URL=http://localhost:8080
SIMPLE_KYC_API_KEY=
SIMPLE_KYC_TENANT=chainlancer
SIMPLE_KYC_REDIRECT_URI=http://localhost:3000/kyc-callback.html

# AML: mock | yente
AML_PROVIDER=mock
YENTE_BASE_URL=http://localhost:8001

# Optional — JSON file store is used when empty
MONGODB_URI=

# Polygon Amoy RPC (public — safe for frontend via VITE_ prefix)
VITE_POLYGON_AMOY_RPC=https://rpc-amoy.polygon.technology
